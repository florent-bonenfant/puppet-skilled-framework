{
    "description": "Guinot - Extranet",
    "name": "globalis/guinot_extranet_back",
    "type": "project",
    "config": {
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "libs/robo-task",
            "options": {
                "symlink": true,
                "versions": {
                    "globalis/robo-task": "2.3.1"
                }
            }
        },
        {
            "type": "path",
            "url": "libs/consolidation-config",
            "options": {
                "symlink": true,
                "versions": {
                    "consolidation/config": "2.1.2"
                }
            }
        },
        {
            "type": "path",
            "url": "libs/consolidation-robo",
            "options": {
                "symlink": false,
                "versions": {
                    "consolidation/robo": "3.0.12"
                }
            }
        },
        {
            "type": "path",
            "url": "libs/illuminate-support",
            "options": {
                "symlink": true,
                "versions": {
                    "illuminate/support": "8.83.27"
                }
            }
        },
        {
            "type": "vcs",
            "url": "git@github.com:globalis-ms/hideme.git"
        },
        {
            "type": "vcs",
            "url":  "git@github.com:florent-bonenfant/puppet-skilled-framework.git"
        }
    ],
    "require": {
        "globalis/puppet-skilled-framework": "dev-feature_require_php8",
        "league/commonmark": "^1.6",
        "stripe/stripe-php": "^10.19",
        "ramsey/uuid": "^4.7",
        "mpdf/mpdf": "^8.2"
    },
    "require-dev": {
        "robmorgan/phinx": "0.12",
        "fakerphp/faker": "^1.21",
        "squizlabs/php_codesniffer": "*",
        "globalis/robo-task": "^2.3.1",
        "globalis/hideme": "dev-develop"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "application/core",
            "App\\Model\\": "application/models",
            "App\\Library\\": "application/libraries",
            "App\\View\\Cell\\": "application/views/Cell",
            "App\\Service\\": "application/services",
            "App\\Job\\": "application/jobs"
        }
    }
}
